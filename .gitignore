# ── Сборка ───────────────────────────────────────────────────────────────────
bin/
obj/
[Dd]ebug/
[Rr]elease/
*.user
*.suo
*.userosscache

# ── Инструменты ──────────────────────────────────────────────────────────────
.vs/
.idea/
.vscode/
*.DotSettings.user

# ── Тесты и покрытие ─────────────────────────────────────────────────────────
TestResults/
*.trx
*.coverage
coverage*.json
coverage*.xml

# ── Секреты ──────────────────────────────────────────────────────────────────
# Секрет подписи токенов хранится в user-secrets или переменной окружения
# и в репозиторий не попадает.
appsettings.Local.json
appsettings.Production.json
*.pfx

# Настройки развёртывания: в них пароль от базы и токен бота.
# Рядом лежит .env.example — образец без значений, он коммитится.
.env

# ── Загруженные пользователями файлы ─────────────────────────────────────────
# Аватары лежат внутри wwwroot (их раздаёт статика), но это данные, а не код:
# у каждого своя картинка, и в репозитории им делать нечего.
EnglishTrainer.Api/wwwroot/avatars/

# ── Локальные данные ─────────────────────────────────────────────────────────
# Кластер PostgreSQL, поднятый прямо в каталоге проекта (например, через initdb
# для проверки на живой базе без Docker). Данные не должны попадать в репозиторий.
.pgdata/
.dotnet-home/

# ── Прочее ───────────────────────────────────────────────────────────────────
*.log
.DS_Store
Thumbs.db
