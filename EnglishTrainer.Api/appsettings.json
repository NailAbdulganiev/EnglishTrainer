{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",

      // Сообщение «No action descriptors found» относится к MVC. Приложение
      // построено на minimal API, поэтому к нему это не относится — без фильтра
      // оно выглядит как ошибка настройки при каждом запуске.
      "Microsoft.AspNetCore.Mvc.Infrastructure.DefaultActionDescriptorCollectionProvider": "Warning"
    }
  },

  "AllowedHosts": "*",

  "ConnectionStrings": {
    // Порт 5433 — контейнер из docker-compose.yml. Своя база задаётся здесь,
    // в user-secrets или переменной окружения ConnectionStrings__Postgres.
    "Postgres": "Host=localhost;Port=5433;Database=english_trainer;Username=postgres;Password=nail"
  },

  "Jwt": {
    // Секрета здесь нет намеренно: в развёртывании он приходит из переменной
    // окружения Jwt__Secret или из user-secrets. Без секрета приложение не стартует.
    "Issuer": "EnglishTrainer",
    "Audience": "EnglishTrainer",
    "LifetimeMinutes": 10080
  },

  "Database": {
    // В развёртывании схему обновляют отдельным шагом, до запуска новых экземпляров:
    // dotnet run --project EnglishTrainer.Api -- migrate
    "AutoMigrate": false,
    "SeedOnStartup": false
  },

  "ReverseProxy": {
    // Включается, когда приложение стоит за обратным прокси (Caddy, nginx).
    // Без этого ссылки строятся по внутреннему адресу и схеме, а перенаправление
    // на HTTPS зацикливается: прокси присылает обычный HTTP, приложение отвечает
    // «перейди на HTTPS», и так по кругу. В docker-compose.prod.yml включается
    // переменной окружения ReverseProxy__Enabled=true.
    "Enabled": false
  }
}
