{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Information"
    }
  },

  "ConnectionStrings": {
    // Локальная база по умолчанию — контейнер из docker-compose.yml (порт 5433).
    // Своя база задаётся в user-secrets или переменной окружения
    // ConnectionStrings__Postgres; они переопределяют это значение.
    "Postgres": "Host=localhost;Port=5433;Database=english_trainer;Username=postgres;Password=postgres"
  },

  "Jwt": {
    // Секрет только для локального запуска. В развёртывании он обязателен
    // и передаётся извне — в репозитории не хранится.
    "Secret": "local-development-signing-key-do-not-use-in-production"
  },

  "Database": {
    // В разработке база приводится в рабочее состояние при старте:
    // применить миграции и загрузить словарь, если он ещё пуст.
    "AutoMigrate": true,
    "SeedOnStartup": true
  }
}
