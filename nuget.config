<?xml version="1.0" encoding="utf-8"?>
<!--
  Источники пакетов заданы явно.

  <clear /> убирает источники, унаследованные из машинной конфигурации NuGet:
  на другой машине там может оказаться корпоративная лента, и сборка проекта
  начнёт зависеть от того, где он открыт.

  Отдельного кеша здесь нет намеренно: глобальная папка пакетов
  (%USERPROFILE%\.nuget\packages) уже работает кешем, и если пакет в ней есть,
  восстановление проходит без обращения к сети. Путь к чужому профилю
  в репозитории был бы машинно-зависимым и на другой машине бесполезным.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
