<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Автономный запуск тестов — общая библиотека, а не часть одного проекта.

    Причина: тестовых проектов два (модульные и интеграционные), и обоим нужен
    один и тот же раннер. Копия на 150 строк разошлась бы при первой же правке —
    например, когда один из проектов научился бы работать с фикстурами,
    а второй нет. Пакет xunit нужен здесь потому, что раннер читает его
    атрибуты: он ищет тесты по [Fact] и [Theory], а не по соглашению об именах.
  -->

  <PropertyGroup>
    <RootNamespace>EnglishTrainer.TestRunner</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit" Version="2.4.2" />
  </ItemGroup>

</Project>
