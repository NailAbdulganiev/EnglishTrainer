# ─────────────────────────────────────────────────────────────────────────────
# Образец настроек развёртывания. Скопируйте в .env и заполните:
#
#   cp .env.example .env
#
# Файл .env перечислен в .gitignore: в нём пароль от базы и токен бота.
# В образ он не попадает — см. .dockerignore.
# ─────────────────────────────────────────────────────────────────────────────

# ── Публичный адрес ──────────────────────────────────────────────────────────
# Домен, по которому открывается сайт и мини-апп. Caddy получит на него
# сертификат Let's Encrypt сам — но домен должен уже указывать A-записью
# на IP сервера, и порты 80 и 443 должны быть открыты.
#
# Домена нет? Возьмите sslip.io: он резолвит любой IP, вписанный в имя,
# и Let's Encrypt выдаёт на такое имя настоящий сертификат.
# Пример для сервера 203.0.113.10:
#   PUBLIC_URL=https://203.0.113.10.sslip.io
PUBLIC_URL=https://trainer.example.com

# ── Порт HTTPS ───────────────────────────────────────────────────────────────
# 443, если он свободен. Если его занимает что-то другое (VPN на xray, панель),
# укажите другой порт — адрес станет https://домен:8443.
#
# Порт 80 освободить придётся в любом случае: через него Let's Encrypt
# подтверждает владение доменом.
HTTPS_PORT=443

# ── База данных ──────────────────────────────────────────────────────────────
POSTGRES_DB=english_trainer
POSTGRES_USER=postgres
# Придумайте пароль. База наружу не публикуется, но пароль всё равно не
# должен быть словарным: сосед по сети в докер-сети — тоже угроза.
POSTGRES_PASSWORD=

# ── Токены ───────────────────────────────────────────────────────────────────
# Секрет подписи токенов доступа. Не короче 32 байт.
# Сгенерировать: openssl rand -base64 48
JWT_SECRET=

# Токен бота от @BotFather.
TELEGRAM_BOT_TOKEN=

# Имя бота без «@» — из него собирается ссылка привязки аккаунта.
TELEGRAM_BOT_USERNAME=
