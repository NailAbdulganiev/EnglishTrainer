{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },

  "Telegram": {
    // Токен здесь не хранится: он приходит из appsettings.Local.json
    // (файл вне репозитория) или из переменной окружения Telegram__BotToken.
    // Без токена бот не стартует и сообщает об этом в журнал.

    // Имя бота без «@» — из него собирается ссылка на привязку аккаунта.
    // Значение видно в @BotFather; задаётся локально.
    "BotUsername": "",

    // Адрес мини-аппа. Обязателен HTTPS: по HTTP кнопка WebApp не работает,
    // и это ограничение Telegram, а не кода. Локально адрес выдаёт туннель
    // (cloudflared, ngrok), см. README.
    "WebAppUrl": "",

    "BotEnabled": true,
    "PollTimeoutSeconds": 30,
    "ReminderTickSeconds": 60
  }
}
