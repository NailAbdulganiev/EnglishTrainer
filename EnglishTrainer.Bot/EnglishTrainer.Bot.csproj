<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    Бот — отдельный процесс, а не часть API.

    Причина в характере работы: бот держит долгоживущее соединение (long polling)
    и просыпается по расписанию, тогда как API отвечает на запросы и живёт
    ровно столько, сколько длится запрос. Смешав их, любой перезапуск API
    обрывал бы доставку напоминаний, а падение бота роняло бы веб-версию.

    SDK выбран Web, а не обычный консольный: он даёт общий фреймворк ASP.NET Core
    с готовыми хостингом, конфигурацией, логированием и HttpClientFactory —
    то есть всё, что нужно фоновому процессу, без единого пакета NuGet.
  -->

  <PropertyGroup>
    <RootNamespace>EnglishTrainer.Bot</RootNamespace>

    <!--
      Тот же идентификатор секретов, что и у API: оба процесса читают один
      и тот же токен бота и один и тот же секрет подписи токенов. Две копии
      секрета разошлись бы, и «мини-апп открывается, а вход в нём не работает»
      выяснялось бы полдня.
    -->
    <UserSecretsId>english-trainer-api</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\EnglishTrainer.Application\EnglishTrainer.Application.csproj" />
    <ProjectReference Include="..\EnglishTrainer.Domain\EnglishTrainer.Domain.csproj" />
    <ProjectReference Include="..\EnglishTrainer.Infrastructure\EnglishTrainer.Infrastructure.csproj" />
  </ItemGroup>

</Project>
